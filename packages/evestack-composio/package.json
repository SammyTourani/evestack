{
  "name": "@evestack/composio",
  "version": "0.2.0",
  "type": "module",
  "description": "One browser flow signs an eve agent into 1000+ tools. Wires Composio's Tool Router into eve, and degrades to a no-op when no API key is set.",
  "license": "Apache-2.0",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "eve",
    "composio",
    "agent",
    "tools",
    "oauth"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test test/*.test.mjs",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@composio/core": "^0.14.1",
    "@composio/experimental": "0.2.1"
  },
  "peerDependencies": {
    "eve": ">=0.30.0 <1.0.0"
  },
  "devDependencies": {
    "@types/node": "24.x",
    "eve": "^0.31.3",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=24"
  },
  "homepage": "https://github.com/SammyTourani/evestack#readme",
  "bugs": {
    "url": "https://github.com/SammyTourani/evestack/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SammyTourani/evestack.git",
    "directory": "packages/evestack-composio"
  },
  "publishConfig": {
    "access": "public"
  }
}
