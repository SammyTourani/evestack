{
  "name": "@evestack/composio",
  "version": "0.1.0",
  "type": "module",
  "description": "One browser flow signs an eve agent into 1000+ tools. Wires Composio's Tool Router into eve, and degrades to a no-op when no API key is set.",
  "license": "Apache-2.0",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "eve",
    "composio",
    "agent",
    "tools",
    "oauth"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@composio/core": "^0.14.1",
    "@composio/experimental": "0.2.1"
  },
  "peerDependencies": {
    "eve": ">=0.29.0 <1.0.0"
  },
  "devDependencies": {
    "@types/node": "24.x",
    "eve": "^0.29.5",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=24"
  }
}
