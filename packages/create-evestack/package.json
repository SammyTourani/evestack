{
  "name": "create-evestack",
  "version": "0.6.0",
  "type": "module",
  "description": "The whole eve stack. On your own machine. Durable Postgres sessions, a Docker sandbox, memory, approvals, schedules, 1,070 tool integrations, and a dashboard that drives the agent.",
  "license": "Apache-2.0",
  "keywords": [
    "eve",
    "agent",
    "self-hosted",
    "ai",
    "postgres",
    "composio",
    "dashboard"
  ],
  "bin": {
    "create-evestack": "./index.mjs"
  },
  "exports": {
    ".": "./create.mjs",
    "./create": "./create.mjs",
    "./attach": "./attach.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "index.mjs",
    "create.mjs",
    "attach.mjs",
    "shared.mjs",
    "template/",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "prepack": "node scripts/sync-template.mjs",
    "test": "node scripts/sync-template.mjs && node --check index.mjs && node --check create.mjs && node --check attach.mjs && node --check shared.mjs && node --test test/*.test.mjs"
  },
  "homepage": "https://github.com/SammyTourani/evestack#readme",
  "bugs": {
    "url": "https://github.com/SammyTourani/evestack/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SammyTourani/evestack.git",
    "directory": "packages/create-evestack"
  }
}
