{
  "name": "@evestack/mcp",
  "version": "0.1.0",
  "type": "module",
  "description": "evestack's control plane as an MCP server. Ask Claude Code why last night's agent run got denied, what it cost, and turn it into a regression test — over stdio, read-only by default.",
  "license": "Apache-2.0",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "evestack-mcp": "./dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "mcp",
    "model-context-protocol",
    "eve",
    "agent",
    "evestack",
    "control-plane",
    "observability"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test test/*.test.mjs",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@types/node": "24.x",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=24"
  },
  "homepage": "https://github.com/SammyTourani/evestack#readme",
  "bugs": {
    "url": "https://github.com/SammyTourani/evestack/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SammyTourani/evestack.git",
    "directory": "packages/evestack-mcp"
  },
  "publishConfig": {
    "access": "public"
  }
}
