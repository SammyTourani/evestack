{
  "name": "@evestack/budget",
  "version": "0.1.0",
  "type": "module",
  "description": "Dollar spend caps for eve agents, per session and per principal per day. Backed by the Postgres you already run, so a cap survives the session that a new session would otherwise reset.",
  "license": "Apache-2.0",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./pricing": {
      "types": "./dist/pricing.d.ts",
      "default": "./dist/pricing.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "scripts",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "eve",
    "agent",
    "budget",
    "cost",
    "rate-limit",
    "spend"
  ],
  "scripts": {
    "build": "node scripts/sync-pricing.mjs && tsc -p tsconfig.json",
    "typecheck": "node scripts/sync-pricing.mjs && tsc -p tsconfig.json --noEmit",
    "prepack": "npm run build",
    "sync-pricing": "node scripts/sync-pricing.mjs"
  },
  "dependencies": {
    "pg": "^8.20.3"
  },
  "peerDependencies": {
    "eve": ">=0.30.0 <1.0.0"
  },
  "devDependencies": {
    "@types/node": "24.x",
    "@types/pg": "^8.20.3",
    "eve": "^0.30.6",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=24"
  },
  "homepage": "https://github.com/SammyTourani/evestack#readme",
  "bugs": {
    "url": "https://github.com/SammyTourani/evestack/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SammyTourani/evestack.git",
    "directory": "packages/evestack-budget"
  },
  "publishConfig": {
    "access": "public"
  }
}
