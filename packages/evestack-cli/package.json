{
  "name": "evestack",
  "version": "0.1.0",
  "type": "module",
  "description": "One command for the whole self-hosted eve stack: `evestack create` scaffolds an agent and a dashboard, `evestack attach` wraps an eve project you already have, and `evestack doctor` explains why a durable job is dead.",
  "license": "Apache-2.0",
  "bin": {
    "evestack": "./bin/evestack.mjs"
  },
  "main": "./src/doctor.mjs",
  "exports": {
    ".": "./src/doctor.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "src",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "eve",
    "agent",
    "self-hosted",
    "scaffold",
    "graphile-worker",
    "postgres",
    "queue",
    "diagnostics",
    "workflow",
    "cli"
  ],
  "scripts": {
    "typecheck": "node scripts/check.mjs",
    "prepack": "node scripts/prepack.mjs",
    "test": "node scripts/check.mjs && node --test test/*.test.mjs"
  },
  "dependencies": {
    "create-evestack": "workspace:^",
    "pg": "^8.20.3"
  },
  "engines": {
    "node": ">=24"
  },
  "homepage": "https://github.com/SammyTourani/evestack#readme",
  "bugs": {
    "url": "https://github.com/SammyTourani/evestack/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SammyTourani/evestack.git",
    "directory": "packages/evestack-cli"
  },
  "publishConfig": {
    "access": "public"
  }
}
