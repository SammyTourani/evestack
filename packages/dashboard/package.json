{
  "name": "@evestack/dashboard",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "description": "Self-hosted observability and control plane for eve agents: sessions, cost, approvals with audit, memory, schedules and evals, read from your own Postgres.",
  "license": "Apache-2.0",
  "homepage": "https://github.com/SammyTourani/evestack/tree/main/packages/dashboard#readme",
  "bugs": {
    "url": "https://github.com/SammyTourani/evestack/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SammyTourani/evestack.git",
    "directory": "packages/dashboard"
  },
  "scripts": {
    "dev": "next dev --port 4000",
    "build": "next build",
    "start": "next start --port 4000",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --import ./test/register-ts-resolve.mjs --test test/*.test.mjs",
    "seed": "node scripts/seed.mjs",
    "seed:purge": "node scripts/seed.mjs --purge"
  },
  "dependencies": {
    "@evestack/schedules": "workspace:*",
    "@radix-ui/react-popover": "^1.1.23",
    "@tanstack/react-table": "8.21.3",
    "@tanstack/react-virtual": "^3.14.9",
    "geist": "^1.7.0",
    "next": "16.3.0",
    "pg": "^8.20.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "3.10.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "24.x",
    "@types/pg": "^8.20.3",
    "@types/react": "19.2.15",
    "@types/react-dom": "19.2.3",
    "tailwindcss": "^4.1.0",
    "typescript": "6.0.3"
  }
}
