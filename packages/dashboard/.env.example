# evestack dashboard — copy to .env.local (never commit the real file)

# --- Required -----------------------------------------------------------------
# The same Postgres your agent writes durable sessions to.
# DATABASE_URL is accepted as a fallback.
WORKFLOW_POSTGRES_URL=postgres://evestack:evestack@localhost:5433/evestack

# Route auth. REQUIRED — with EVESTACK_AUTH_PASSWORD unset the dashboard refuses
# every request rather than serving one, /api/health reports unhealthy, and the
# sign-in page says why. There is no bypass flag on purpose: this app starts
# agent runs, approves gated shell commands and deletes memories, and the
# container binds 0.0.0.0.
#
# It is the SAME pair the agent uses — `create-evestack` generates it, and the
# dashboard both signs you in with it and sends it onward to an agent started
# with `eve build && eve start`, which fails closed on every request including
# loopback. One secret per deployment beats two that drift apart.
EVESTACK_AUTH_USER=evestack
EVESTACK_AUTH_PASSWORD=

# --- Driving the agent --------------------------------------------------------
# Where the agent is listening. `eve dev` uses 2000, but auto-increments if that
# port is taken — read the real port from its startup log.
# EVESTACK_AGENT_URL=http://127.0.0.1:2000

# --- Sessions and identity ----------------------------------------------------
# The signing key for the session cookie. Defaults to a value derived from
# EVESTACK_AUTH_PASSWORD, so changing the password invalidates every outstanding
# cookie. Set this to rotate sessions without rotating the password, or to let
# several dashboard replicas accept each other's cookies.
# EVESTACK_SESSION_SECRET=

# How long a browser session lasts. Default 168 (seven days).
# EVESTACK_SESSION_TTL_HOURS=168

# Whether X-Forwarded-User / X-Forwarded-Email / EVESTACK_APPROVER_HEADER may be
# believed. UNTIL THIS IS SET THEY ARE NOT READ AT ALL — anyone who can reach
# the port can send those headers, and an audit log that can be dictated to is
# worse than one that admits it knows nothing.
#
# Set it to 1 when a reverse proxy you control terminates every request AND
# strips the client's own X-Forwarded-* headers (that stripping is the real
# control; this variable records that you did it). Or give a comma-separated
# list of addresses — exact match for any family, CIDR for IPv4 — that the
# nearest hop must match, as a second lock.
# EVESTACK_TRUSTED_PROXY=1
# EVESTACK_TRUSTED_PROXY=172.16.0.0/12,10.0.0.5

# The header your proxy puts the signed-in person's name in, if it is not one of
# the two X-Forwarded-* names. Only read when EVESTACK_TRUSTED_PROXY is set.
# EVESTACK_APPROVER_HEADER=x-auth-request-email

# Refuse any approval or memory deletion that cannot be attributed. Worth
# knowing what it buys: with route auth on, a request that reaches the approve
# route has already proved the deployment credential, so pair this with
# EVESTACK_TRUSTED_PROXY when you need a human's name in the row rather than the
# installation's.
# EVESTACK_REQUIRE_APPROVER=1

# --- Trace ingest -------------------------------------------------------------
# Shared secret for POST /api/ingest/v1/traces, the one route whose caller is a
# program rather than a person. The exporter sends it as the header
# `x-evestack-ingest-token` (or as a Bearer token); the agent needs the same
# value in its own .env.local next to EVESTACK_DASHBOARD_URL.
#
# Unset, the route falls back to ordinary session auth — never to open. Spans
# carry system prompts and tool arguments, and an open POST also lets anyone
# write rows the dashboard will display as a real conversation.
#
# Which means: if you want traces at all, SET IT, here and on the agent, to the
# same value (`openssl rand -hex 32`). An exporter holds no cookie and no
# password, so with this unset every span 401s — and the agent's OTLP exporter
# reports a 401 batch as a successful export, so the only symptom is a Traces
# tab that never fills. See app/api/ingest/README.md.
# EVESTACK_INGEST_TOKEN=

# --- Integrations -------------------------------------------------------------
# Enables the Integrations page. Without it that page says so and does nothing.
# Use the same key as the agent, or the dashboard will connect accounts the
# agent cannot see.
# COMPOSIO_API_KEY=ak_...

# Must match the agent's user id, for the same reason. Defaults to "evestack".
# EVESTACK_COMPOSIO_USER_ID=evestack

# --- Optional -----------------------------------------------------------------
# Absolute origin used to build OAuth callback URLs, to decide whether the
# session cookie carries `Secure`, and as an accepted origin for cross-site
# write checks. Set this if the dashboard sits behind a proxy under a different
# hostname than it sees on the request.
# EVESTACK_PUBLIC_URL=http://localhost:4000

# Postgres pool size for the dashboard's own reads. Default 8.
# EVESTACK_DB_POOL_MAX=8

# JSON overriding or extending the built-in per-model token prices. Models with
# no price are labelled `unpriced` rather than counted as free.
# EVESTACK_PRICING={"openai/gpt-5-mini":{"input":0.25,"output":2}}

# --- Alert delivery -----------------------------------------------------------
# The nine monitors on /monitors are computed whether or not this is set. This
# is what makes them leave the machine. Unset, they are shown on the page and
# told to nobody, and the page says so.
#
# Slack incoming webhook, Discord webhook, or any HTTPS endpoint you control —
# the payload shape is detected from the hostname. Comma-separate for several.
# See /docs/alerts.
# EVESTACK_ALERT_WEBHOOK_URL=https://hooks.slack.com/services/T0/B0/xxxx

# Override the detected payload shape: slack | discord | webhook. Only needed
# when posting through a proxy that hides the vendor's hostname.
# EVESTACK_ALERT_WEBHOOK_FORMAT=slack

# Shared secret for the generic `webhook` shape. Every POST is then signed
# HMAC-SHA256 over "<timestamp>.<body>" in x-evestack-alert-signature. Slack and
# Discord authenticate by secret URL and ignore this.
# EVESTACK_ALERT_WEBHOOK_SECRET=

# How often to evaluate. Default 60, floor 15 — below that the loop evaluates
# faster than the checks it runs.
# EVESTACK_ALERT_INTERVAL_SECONDS=60

# Repeat a still-firing alert every N minutes. Off by default: only state
# CHANGES are sent, so a monitor that stays firing is mentioned once.
# EVESTACK_ALERT_RENOTIFY_MINUTES=0

# Install-wide daily spend the "Spend today" monitor is judged against. Unset,
# it falls back to @evestack/budget's EVESTACK_BUDGET_DAILY_USD (default 10) and
# says in the alert that it did — those are different measures, per-install
# versus per-principal. `false` switches spend alerting off entirely.
# EVESTACK_ALERT_DAILY_SPEND_USD=

# --- Sandboxes and traces -----------------------------------------------------
# Path to the Docker socket, which turns the /sandboxes page on. OFF unless this
# names a path, and deliberately so: a process that can talk to the Docker socket
# can start a container with the host filesystem mounted, which makes it
# root-equivalent on this machine. Reading is all this does — lifecycle actions
# need EVESTACK_DOCKER_LIFECYCLE as well.
# EVESTACK_DOCKER_SOCKET=/var/run/docker.sock

# Allow the dashboard to stop and remove sandbox containers, not just list them.
# EVESTACK_DOCKER_LIFECYCLE=1

# Days of spans kept before pruning. Default 30. `0` turns pruning off, which is
# a legitimate choice for a machine where disk is cheap and history is not.
# EVESTACK_TRACE_RETENTION_DAYS=30

# Span names to discard at ingest, comma-separated. Unset keeps the built-in
# list (`workflow.stream.read.complete`, which is ~92% of what a real eve install
# sends). An EMPTY value keeps every span; a list replaces the default entirely.
# EVESTACK_TRACE_DROP_SPANS=

# How long to wait for a Postgres connection before giving up. Default 5000.
# EVESTACK_DB_CONNECT_TIMEOUT_MS=5000
