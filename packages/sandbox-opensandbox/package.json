{
  "name": "@evestack/sandbox-opensandbox",
  "version": "0.1.0",
  "type": "module",
  "description": "Run an eve agent's sandbox on Alibaba OpenSandbox — gVisor isolation, sub-second cold starts, Apache-2.0.",
  "license": "Apache-2.0",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./package.json": "./package.json"
  },
  "files": ["dist", "README.md"],
  "keywords": ["eve", "sandbox", "opensandbox", "gvisor", "agent", "isolation"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@alibaba-group/opensandbox": "^0.1.11"
  },
  "peerDependencies": {
    "eve": ">=0.29.0 <1.0.0"
  },
  "devDependencies": {
    "@types/node": "24.x",
    "eve": "^0.29.5",
    "typescript": "7.0.2"
  },
  "engines": { "node": ">=24" }
}
