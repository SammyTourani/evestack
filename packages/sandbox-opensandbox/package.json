{
  "name": "@evestack/sandbox-opensandbox",
  "version": "0.1.0",
  "type": "module",
  "description": "Run an eve agent's sandbox on Alibaba OpenSandbox — gVisor isolation, sub-second cold starts, Apache-2.0.",
  "license": "Apache-2.0",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "eve",
    "sandbox",
    "opensandbox",
    "gvisor",
    "agent",
    "isolation"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@alibaba-group/opensandbox": "^0.1.11"
  },
  "peerDependencies": {
    "eve": ">=0.29.0 <1.0.0"
  },
  "devDependencies": {
    "@types/node": "24.x",
    "eve": "^0.30.2",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=24"
  },
  "homepage": "https://github.com/SammyTourani/evestack#readme",
  "bugs": {
    "url": "https://github.com/SammyTourani/evestack/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SammyTourani/evestack.git",
    "directory": "packages/sandbox-opensandbox"
  },
  "publishConfig": {
    "access": "public"
  }
}
