{
  "name": "evestack-monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "A fully free, self-hosted distribution of the eve agent framework.",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.27.0",
  "scripts": {
    "typecheck": "pnpm -r --if-present typecheck",
    "build": "pnpm -r --if-present build",
    "contract": "node contract/run.mjs",
    "runtime": "node contract/runtime/run.mjs",
    "test": "node contract/run.mjs && npm run contract:test && pnpm -r --if-present test",
    "contract:test": "node --test contract/test/*.test.mjs"
  },
  "devDependencies": {
    "pg": "^8.22.0",
    "typescript": "6.0.3"
  }
}
