# evestack configuration — copy to .env.local (never commit the real file)

# --- Model provider -----------------------------------------------------------
# Direct provider call. No AI Gateway, no Vercel account, no markup.
OPENAI_API_KEY=sk-proj-...

# Optional. Defaults to gpt-5-mini.
# EVESTACK_MODEL=gpt-5

# --- Durable sessions ---------------------------------------------------------
# Set by docker compose. Without it, eve falls back to its local on-disk world
# under .eve/.workflow-data.
WORKFLOW_POSTGRES_URL=postgres://evestack:evestack@localhost:5433/evestack

# world-postgres defaults to concurrency 50 against a pool of 10, which it warns
# about on every boot. Matching them silences the warning and stops workers from
# queueing on connections.
WORKFLOW_POSTGRES_MAX_POOL_SIZE=20
WORKFLOW_POSTGRES_WORKER_CONCURRENCY=20

# --- Route auth ---------------------------------------------------------------
# eve fails closed. `create-evestack` generates these. Requests whose Host is a
# literal loopback name skip them — see agent/channels/eve.ts.
EVESTACK_AUTH_USER=evestack
EVESTACK_AUTH_PASSWORD=change-me

# --- Dashboard ----------------------------------------------------------------
# When set, the agent exports OpenTelemetry traces to the evestack dashboard.
# This is the dashboard's own ingest route, not the conventional OTLP port 4318 —
# the dashboard is a Next.js app on 4000 and serves OTLP/HTTP JSON at this path.
#
# LEAVE THIS UNSET UNLESS YOU WANT TRACES SPECIFICALLY. The dashboard's main
# views — sessions, turns, tokens, cost, approvals — read eve's Postgres tables
# and need no exporter at all. Turning this on authors instrumentation, and eve
# only installs its agent-level OpenTelemetry from the local tracing runtime it
# then refuses to start ("another runtime already exists"). Measured on 0.30.6:
# exporting yields workflow plumbing spans plus a bare `ai.eve.turn`, no prompts,
# and it also costs you `eve traces`. Reported upstream.
# EVESTACK_DASHBOARD_URL=http://localhost:4000/api/ingest/v1/traces

# --- Spend caps ---------------------------------------------------------------
# On by default at $2 per session and $10 per principal per day. An opt-in
# budget is a budget nobody turns on, and eve's own ceiling is 40M input tokens
# per session — roughly $120-600 — with output uncapped.
#
# This PAUSES at the cap plus at most one step already in flight; it is not a
# hard limit. eve threads no abortSignal into model calls, so a generation
# already streaming cannot be killed. See packages/evestack-budget/README.md.
# EVESTACK_BUDGET_SESSION_USD=2
# EVESTACK_BUDGET_DAILY_USD=10
# EVESTACK_BUDGET_DISABLED=1

# --- Integrations -------------------------------------------------------------
# One-click sign-in to 1000+ tools. Get a key at app.composio.dev.
# COMPOSIO_API_KEY=ak_...

# --- Channels -----------------------------------------------------------------
# All three ship in agent/channels/ and cost nothing. Leave a channel's vars
# unset and it registers its route, logs one line at boot and stays idle — the
# agent still boots and the HTTP channel is unaffected. Every one of these needs
# a PUBLIC HTTPS URL: none of the three has a polling mode, so a laptop needs a
# tunnel (`cloudflared tunnel --url http://localhost:2000`). Full setup, scope by
# scope and click by click, is in docs/channels/.
#
# None of these routes sit behind EVESTACK_AUTH_* — that policy covers
# /eve/v1/session* only, and no chat provider can send Basic credentials. Each
# channel carries its own inbound verification instead, so do not put a reverse
# proxy with Basic auth in front of them.

# Telegram — the fastest one to finish: BotFather gives you a token in a minute.
# Register the webhook yourself; eve never calls setWebhook.
# TELEGRAM_BOT_TOKEN=123456789:AAH...
# TELEGRAM_WEBHOOK_SECRET_TOKEN=      # you invent it (`openssl rand -hex 32`);
#                                     # it is this route's ONLY auth
# TELEGRAM_BOT_USERNAME=my_bot        # optional, no @ — needed for group @mentions

# Slack — bot token plus signing secret. No Vercel account and no Connect
# connector: eve falls back to both env vars when `credentials` is omitted.
# The signing secret must be set BEFORE you save the Request URL, because Slack
# signs the url_verification challenge like any other request.
# SLACK_BOT_TOKEN=xoxb-...
# SLACK_SIGNING_SECRET=

# Discord — the public key is the only one that is genuinely required at runtime;
# eve verifies Discord's Ed25519 signature with it and 401s everything without it,
# including Discord's endpoint-verification PING.
# DISCORD_PUBLIC_KEY=
# DISCORD_APPLICATION_ID=             # needed to register slash commands
# DISCORD_BOT_TOKEN=                  # optional: typing, proactive posts, fallback
# DISCORD_ALLOWED_GUILD_IDS=          # optional allow-list; unset = any guild
