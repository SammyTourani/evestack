{
  "compilerOptions": {
    "target": "ES2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": ["node"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    // `moduleResolution: "bundler"` ignores package.json `imports`, so the `#*`
    // subpath has to be restated here or nothing under agent/ can use it.
    // Deliberately no `#lib/*`: lib/ is imported relatively, because those files
    // also ship as the @evestack/memory registry item and land in projects that
    // have no such mapping.
    "paths": {
      "#*": ["./agent/*"]
    }
  },
  "include": ["agent/**/*.ts", "lib/**/*.ts", "evals/**/*.ts", "scripts/**/*.ts"]
}
